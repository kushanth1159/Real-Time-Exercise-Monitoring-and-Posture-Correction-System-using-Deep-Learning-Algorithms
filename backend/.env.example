# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/fitness_tracker
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/fitness_tracker
MONGODB_URI=mongodb://localhost:27017/fitness_tracker

# JWT Secret Key (change this to a secure random string)
JWT_SECRET=your_super_secret_key_change_this_in_production_123456

# Server Port
PORT=5000
